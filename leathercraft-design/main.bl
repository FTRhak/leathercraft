    46e6a004b81cee70 t("Світлі відповідники темної палітри. Акцент і кольори полотна взято з Palette::LIGHT у src/editor/palette.rs; кольори інтерфейсу — пропозиція, щоб світла тема мала ту саму ієрархію поверхонь, меж і тексту.",Inter,13,r,align(l),lh(1.5)) p(0,44) s(760,hug:39) f[(5eb64ae9aa24cb66,#6B6F7B)] "Text 361"
