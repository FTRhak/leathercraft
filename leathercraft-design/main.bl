    da19b0562fb14d74 t("Елементи керування, винесені з макетів панелі властивостей і діалогу налаштувань. Кожен — компонент Brilliant зі станами як варіантами; приклад унизу зібрано лише з екземплярів.",Inter,13,r,align(l),lh(1.5)) p(0,44) s(820,hug:39) f[(4a0455ae0d3f4039,#8E929F)] "Text 515"
