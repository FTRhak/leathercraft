      decbc88a236a7e63 t("Основна — одна на діалог (OK). Другорядна — Скасувати. Контурна — допоміжні дії (Скинути до типових). Кнопка-іконка — панелі інструментів і керування виглядом. Група кнопок — вибір одного з кількох тісно пов’язаних режимів (одиниці, 2D/3D); сегменти мають стани: типовий, наведення, вибраний, фокус, вимкнений.",Inter,12,r,align(l),lh(auto,1.25)) p(0,23) s(fill,hug:30) ext(1304,) f[(c73a1938146dd02a,#8E929F)] "Text 517"
