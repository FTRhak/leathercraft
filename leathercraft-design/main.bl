      611b32f5e5f9aa81 t("Перемикачі та мітки",Inter,16,sb,align(l),lh(auto,1.19)) p(0,0) s(hug:164.34,hug:19) f[(28fff1158cffc11a,#ECEEF2)] "Text 522"
      f0b2cf1ac4abdd71 t("Прапорець — булеві налаштування (Авто), зі станом «частково» для змішаного вибору. Перемикач (радіо) — один варіант із кількох (одиниці виміру). Тумблер — миттєве увімкнення режиму (прилипання). Чип-перемикач — увімкнення шарів і режимів. Мітка — значення лише для читання. Стани: типовий, наведення, фокус, вимкнений.",Inter,12,r,align(l),lh(auto,1.25)) p(0,23) s(fill,hug:30) ext(1304,) f[(2101cfc2d94de8c3,#8E929F)] "Text 523"
